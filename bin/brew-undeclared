#!/bin/zsh

# List installed packages that nothing declares.
#
# `brew list --installed-on-request` is the set of formulae installed on purpose
# rather than as a dependency of something else.  Every one of those should be
# declared in a Brewfile, otherwise a machine rebuilt from these dotfiles would
# not have it.  Anything printed here is drift.
#
# Casks need handling of their own, and getting it wrong is silent: Homebrew
# records no "installed on request" flag for casks, and
# `brew list --installed-on-request --cask` is not a valid combination - it
# prints usage rather than failing, so the mistake looks like an empty result.
# Casks are therefore compared against every installed cask.  Without this half
# of the comparison, a cask could be dropped from a Brewfile and the app left
# installed would go unnoticed - exactly the drift this script exists to find.
#
# Two directions of drift exist; this is the "installed but undeclared" one.
# The other ("declared but not installed") is `brew bundle check`.

. $(dirname $0)/_env.zsh

typeset -a declared_formula declared_cask
declared_formula=()
declared_cask=()

for brewfile in $DOTFILES_HOME/modules/*/Brewfile; do
    [[ -e "$brewfile" ]] || continue

    # Note: not `IFS= read` - an empty IFS turns off field splitting, which
    # would put the whole "brew name" line into kind and leave name empty.
    while read -r kind name; do
        # ${name:t} drops a tap prefix so someorg/tap/sometool matches sometool
        case "$kind" in
        brew) declared_formula+=("${name:t}") ;;
        cask) declared_cask+=("${name:t}") ;;
        esac
    done < <(sed -nE 's/^(brew|cask) "([^"]+)".*/\1 \2/p' $brewfile)
done

# Formulae: only those installed on purpose.  A dependency is pulled in by
# whatever depends on it, so it does not need declaring.
for leaf in ${(f)"$(brew list --installed-on-request --formula 2>/dev/null)"}; do
    if (( ! ${declared_formula[(Ie)$leaf]} )); then
        echo "$leaf"
    fi
done

# Casks: all of them - see the note at the top of this file for why.
for leaf in ${(f)"$(brew list --cask 2>/dev/null)"}; do
    if (( ! ${declared_cask[(Ie)$leaf]} )); then
        echo "$leaf"
    fi
done
